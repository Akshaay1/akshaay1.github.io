+        ball.style.transform = 'translate(0, 0)';
+        ball.style.left = '40px';
+        ball.style.top = '';
+        ball.style.bottom = '40px';
+    }
+    
+    function resetGame() {
+        score = 0;
+        scoreDisplay.textContent = `Score: ${score}`;
+        
+        if (!ballInMotion) {
+            resetBallPosition();
+        }
+    }
+} 
